{
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "exclusive": true,
  "gtk-layer-shell": true,
  "margin-top": 6,
  "margin-bottom": 0,
  "passthrough": false,
  "height": 0,
  "modules-left": [
    "group/leftSide"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "tray",
    "group/rightSide"
  ],
  "hyprland/language": {
    "format": "{}",
    "format-en": "ENG",
    "format-ru": "RU",
    "format-uk": "UA",
    "menu": "on-click",
    "menu-file": "/home/samedy/.config/waybar/language_menu.xml",
    "menu-actions": {
      "en": "hyprctl switchxkblayout all 0",
      "ru": "hyprctl switchxkblayout all 1",
      "uk": "hyprctl switchxkblayout all 2"
    }
  },
  "custom/search": {
    "format": " ",
    "tooltip": false,
    "on-click": "wofi --show drun"
  },
  "custom/media-play-pause": {
    "interval": 1,
    "format": "{}",
    "exec": "playerctl status 2>/dev/null | grep -q Playing && echo '⏸' || playerctl status 2>/dev/null | grep -q Paused && echo '▶' || echo ''",
    "on-click": "playerctl play-pause",
    "tooltip": false
  },
  "custom/media-prev": {
    "interval": 1,
    "format": "{}",
    "exec": "playerctl status 2>/dev/null | grep -qE 'Playing|Paused' && echo '⏮' || echo ''",
    "on-click": "playerctl previous",
    "tooltip": false
  },
  "custom/media-next": {
    "interval": 1,
    "format": "{}",
    "exec": "playerctl status 2>/dev/null | grep -qE 'Playing|Paused' && echo '⏭' || echo ''",
    "on-click": "playerctl next",
    "tooltip": false
  },
  "mpris": {
    "format": "{dynamic}",
    "format-paused": "{dynamic}",
    "format-stopped": "",
    "dynamic-len": 30,
    "dynamic-order": [
      "title",
      "artist"
    ],
    "dynamic-separator": " - ",
    "tooltip": true,
    "tooltip-format": "{player}\n{dynamic}\n{position}/{length}",
    "on-click-right": "hyprctl dispatch focuswindow $(playerctl -l | head -n 1)",
    "max-length": 30
  },
  "network": {
    "format-wifi": "{icon} {essid}",
    "max-length": 28,
    "format-ethernet": " ",
    "format-disconnected": "󰌙 ",
    "tooltip-format": "{icon} {essid}",
    "format-icons": [
      "󰤯 ",
      "󰤟 ",
      "󰤢 ",
      "󰤢 ",
      "󰤨 "
    ],
    "on-click": "bash ~/.config/hypr/scripts/actioncenter.sh",
    "on-click-right": "bash ~/.config/hypr/scripts/rofiwifi.sh"
  },
  "battery": {
    "on-click": "bash ~/.config/hypr/scripts/actioncenter.sh",
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20
    },
    "format": "{icon} {capacity}%",
    "format-charging": " ",
    "format-plugged": " ",
    "format-alt": "{time} {icon}",
    "format-alt-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "format-icons": [
      "󰂎",
      "󰁻",
      "󰁽",
      "󰁿",
      "󰁹"
    ]
  },
"pulseaudio": {
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-icons": {
        "headphone": "",
        "hands-free": "",
        "headset": "",
        "phone": "",
        "portable": "",
        "car": "",
        "default": [
            "", 
            "", 
            "󰕾", 
            "󰕾", 
            "", 
            "", 
            ""
        ]
    },
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
},
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}",
    "tooltip-format": "{icon} {percent}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "on-click": "bash ~/.config/hypr/scripts/actioncenter.sh"
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "icon-size": 32,
    "spacing": 16,
    "on-scroll-up": "hyprctl dispatch workspace r+1",
    "on-scroll-down": "hyprctl dispatch workspace r-1",
    "persistent-workspaces": {
      "*": 4
    },
    "format-icons": {
      "urgent": "",
      "sort-by-number": true
    }
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8
  },
  "clock": {
    "format": "  {:%R}",
    "tooltip-format": " {:%d %B %Y}"
  },
  "memory": {
    "format": "󰍛 {}%",
    "format-alt": "󰍛 {used}/{total} GiB",
    "interval": 5
  },
  "cpu": {
    "format": "󰻠 {usage}%",
    "format-alt": "󰻠 {avg_frequency} GHz",
    "interval": 5
  },
  "custom/gpu": {
    "exec": "cat /sys/class/drm/card1/device/gpu_busy_percent",
    "format": "󰢮 {}%",
    "interval": 5
  },
  "group/hardware": {
    "orientation": "horizontal",
    "modules": [
      "memory",
      "cpu",
      "custom/gpu"
    ]
  },
  "group/controlCenter": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio",
      "network",
      "backlight"
    ]
  },
  "group/mediaPlayer": {
    "orientation": "horizontal",
    "modules": [
      "custom/media-prev",
      "mpris",
      "custom/media-play-pause",
      "custom/media-next"
    ]
  },
  "group/leftSide": {
    "orientation": "horizontal",
    "modules": [
      "custom/search",
      "custom/runner",
      "group/mediaPlayer",
      "group/hardware"
    ]
  },
  "group/rightSide": {
    "orientation": "horizontal",
    "modules": [
      "group/controlCenter",
      "battery",
      "hyprland/language",
      "clock"
    ]
  }
}
