(defpoll brightness :interval "1h"
                    "~/.config/eww/scripts/brightness-get.sh")

(defwidget brightness-window []
  (box :class "brightness-box" :orientation "v" :space-evenly false :spacing 8
    (box :orientation "h" :space-evenly false :spacing 8
      (label :class "brightness-icon" :text "󰃟")
      (label :class "brightness-title" :text "Яркость" :hexpand true :halign "start")
      (label :class "brightness-value" :text "${round(brightness, 0)}%"))
    (scale :min 0
           :max 105
           :value brightness
           :onchange "~/.config/eww/scripts/brightness.sh {}"
           :class "brightness-scale")))

(defwindow brightness
  :monitor 0
  :geometry (geometry :x "6px" :y "6px" :width "300px" :anchor "top left")
  :stacking "fg"
  (brightness-window))
