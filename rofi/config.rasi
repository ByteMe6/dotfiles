/* COMPACT SPOTLIGHT */

configuration {
    show-icons:          true;
    icon-theme:          "Papirus";
    drun-display-format: "{name}";
    disable-history:     false;
    modi:                "drun,calc,filebrowser,window";
    display-drun:        "Apps";
    display-calc:        "Calc";
    display-filebrowser: "Files";
    display-window:      "Windows";
}

* {
    font:             "Montserrat 10";
    bg0:              #1a1a2eee;
    bg2:              #ffffff12;
    bg3:              #ffffff25;
    bg4:              #0860f2cc;
    fg0:              #ffffff;
    fg1:              #ffffff55;
    background-color: transparent;
    text-color:       @fg0;
    padding:          0px;
    margin:           0px;
}

window {
    width:            640px;
    border-radius:    16px;
    background-color: @bg0;
    border:           1px;
    border-color:     @bg3;
    location:         north;
    y-offset:         80px;
}

mainbox {
    padding:  12px;
    spacing:  8px;
    children: [inputbar, mode-switcher, listview, message];
}

inputbar {
    background-color: @bg2;
    padding:          10px 14px;
    spacing:          8px;
    border:           1px;
    border-radius:    10px;
    border-color:     @bg3;
    children:         [icon-search, entry];
}

prompt { enabled: false; }

icon-search {
    expand:         false;
    filename:       "search";
    vertical-align: 0.5;
    size:           1em;
    text-color:     @fg1;
}

entry {
    placeholder:       "Search apps, calc, files...";
    placeholder-color: @fg1;
    text-color:        @fg0;
}

mode-switcher {
    spacing: 6px;
}

button {
    padding:          4px 14px;
    border-radius:    16px;
    background-color: @bg2;
    text-color:       @fg1;
    cursor:           pointer;
    border:           1px;
    border-color:     transparent;
}

button selected {
    background-color: @bg4;
    text-color:       @fg0;
}

listview {
    spacing:       4px;
    columns:       1;
    lines:         8;
    fixed-height:  true;
    scrollbar:     false;
}

element, element-text, element-icon {
    cursor: pointer;
}

element {
    padding:          8px 10px;
    spacing:          12px;
    orientation:      horizontal;
    border-radius:    10px;
    background-color: transparent;
}

element selected {
    background-color: @bg4;
}

element-icon {
    size:             1.4em;
    vertical-align:   0.5;
}

element-text {
    vertical-align: 0.5;
}

message {
    padding:          8px 10px;
    border-radius:    10px;
    background-color: @bg2;
}

textbox {
    text-color: @fg0;
}
