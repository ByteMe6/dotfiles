@import "colors.rasi"

configuration {
    show-icons:          true;
    icon-theme:          "Papirus";
    drun-display-format: "{name}";
    disable-history:     false;
    modi:                "drun,calc,filebrowser,window";
    display-drun:        "Apps";
    display-calc:        "Calc";
    display-filebrowser: "Files";
    display-window:      "Windows";
}

* {
    font:             "Montserrat 10";
    background-color: transparent;
    text-color:       @fg-main;
    padding:          0px;
    margin:           0px;
}

window {
    width:            620px;
    border-radius:    14px;
    background-color: @bg-window;
    border:           1px;
    border-color:     @bd-main;
    location:         north;
    y-offset:         80px;
}

mainbox {
    padding:  12px;
    spacing:  8px;
    children: [inputbar, mode-switcher, listview, message];
}

inputbar {
    background-color: @bg-input;
    padding:          10px 14px;
    spacing:          8px;
    border:           1px;
    border-radius:    10px;
    border-color:     @bd-main;
    children:         [icon-search, entry];
}

prompt { enabled: false; }

icon-search {
    expand:         false;
    filename:       "search";
    vertical-align: 0.5;
    size:           1em;
    text-color:     @fg-dim;
}

entry {
    placeholder:       "Search apps, calc, files...";
    placeholder-color: @fg-faint;
    text-color:        @fg-main;
}

mode-switcher {
    spacing: 6px;
}

button {
    padding:          4px 14px;
    border-radius:    16px;
    background-color: @bg-input;
    text-color:       @fg-dim;
    cursor:           pointer;
    border:           1px;
    border-color:     @bd-main;
}

button selected {
    background-color: @accent;
    text-color:       @on-accent;
    border-color:     @accent;
}

listview {
    spacing:      4px;
    columns:      1;
    lines:        8;
    fixed-height: true;
    scrollbar:    false;
}

element, element-text, element-icon {
    cursor: pointer;
}

element {
    padding:      8px 10px;
    spacing:      12px;
    orientation:  horizontal;
    border-radius: 8px;
}

element normal normal {
    background-color: @bg-element;
    text-color:       @fg-main;
}

element normal active {
    background-color: @bg-element;
    text-color:       @fg-main;
}

element selected normal {
    background-color: @accent;
    text-color:       @on-accent;
}

element selected active {
    background-color: @accent;
    text-color:       @on-accent;
}

element-icon {
    size:           1.4em;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
}

element alternate normal {
    background-color: @bg-element;
    text-color:       @fg-main;
}

element alternate active {
    background-color: @bg-element;
    text-color:       @fg-main;
}


message {
    padding:          8px 10px;
    border-radius:    8px;
    background-color: @bg-input;
    border:           1px;
    border-color:     @bd-main;
}

textbox {
    text-color: @fg-main;
}