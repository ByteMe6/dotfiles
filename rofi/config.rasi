configuration {
    show-icons:          true;
    icon-theme:          "Papirus";
    drun-display-format: "{name}";
    disable-history:     false;
    modi:                "drun,calc,filebrowser,window";
    display-drun:        "Apps";
    display-calc:        "Calc";
    display-filebrowser: "Files";
    display-window:      "Windows";
}

* {
    font:             "Montserrat 10";
    bg0:              #111111f0;
    bg2:              #1e1e1e;
    bg3:              #2e2e2e;
    background-color: transparent;
    text-color:       #eeeeee;
    padding:          0px;
    margin:           0px;
}

window {
    width:            620px;
    border-radius:    14px;
    background-color: @bg0;
    border:           1px;
    border-color:     @bg3;
    location:         north;
    y-offset:         80px;
}

mainbox {
    padding:  12px;
    spacing:  8px;
    children: [inputbar, mode-switcher, listview, message];
}

inputbar {
    background-color: @bg2;
    padding:          10px 14px;
    spacing:          8px;
    border:           1px;
    border-radius:    10px;
    border-color:     @bg3;
    children:         [icon-search, entry];
}

prompt { enabled: false; }

icon-search {
    expand:         false;
    filename:       "search";
    vertical-align: 0.5;
    size:           1em;
    text-color:     #888888;
}

entry {
    placeholder:       "Search apps, calc, files...";
    placeholder-color: #666666;
    text-color:        #eeeeee;
}

mode-switcher {
    spacing: 6px;
}

button {
    padding:          4px 14px;
    border-radius:    16px;
    background-color: @bg2;
    text-color:       #888888;
    cursor:           pointer;
    border:           1px;
    border-color:     @bg3;
}

button selected {
    background-color: #eeeeee;
    text-color:       #111111;
    border-color:     #eeeeee;
}

listview {
    spacing:      4px;
    columns:      1;
    lines:        8;
    fixed-height: true;
    scrollbar:    false;
}

element, element-text, element-icon {
    cursor: pointer;
}

element {
    padding:      8px 10px;
    spacing:      12px;
    orientation:  horizontal;
    border-radius: 8px;
}

element normal normal {
    background-color: #222222;
}

element normal active {
    background-color: #222222;
}

element selected normal {
    background-color: #383838;
}

element selected active {
    background-color: #383838;
}

element-icon {
    size:           1.4em;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color:     #eeeeee;
}

element alternate normal {
    background-color: #222222;
}

element alternate active {
    background-color: #222222;
}


message {
    padding:          8px 10px;
    border-radius:    8px;
    background-color: @bg2;
    border:           1px;
    border-color:     @bg3;
}

textbox {
    text-color: #eeeeee;
}